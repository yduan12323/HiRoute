# Python/local environment
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.env
.venv/
build/
dist/

# Generated experiment data and outputs (never publish these trees).
/data/raw/osm/**
/data/raw/opportunities/**
